# Copy to .env (lab.sh nautobot install does this, generating the secrets).
NAUTOBOT_IMAGE_TAG=3.2-py3.12

# Web
NAUTOBOT_ALLOWED_HOSTS=*
NAUTOBOT_SECRET_KEY=CHANGE_ME_50_random_characters
NAUTOBOT_DEBUG=False
NAUTOBOT_LOG_LEVEL=INFO
NAUTOBOT_TIME_ZONE=UTC
NAUTOBOT_BANNER_TOP=cat9000v lab NMS

# First-boot superuser (the entrypoint only creates it if it does not exist yet)
NAUTOBOT_CREATE_SUPERUSER=true
NAUTOBOT_SUPERUSER_NAME=admin
NAUTOBOT_SUPERUSER_EMAIL=admin@lab.local
NAUTOBOT_SUPERUSER_PASSWORD=admin
NAUTOBOT_SUPERUSER_API_TOKEN=CHANGE_ME_40_hex_characters

# Database
NAUTOBOT_DB_ENGINE=django.db.backends.postgresql
NAUTOBOT_DB_HOST=postgres
NAUTOBOT_DB_PORT=5432
NAUTOBOT_DB_NAME=nautobot
NAUTOBOT_DB_USER=nautobot
NAUTOBOT_DB_PASSWORD=CHANGE_ME
NAUTOBOT_DB_TIMEOUT=300

# Redis (cache + Celery broker)
NAUTOBOT_REDIS_HOST=redis
NAUTOBOT_REDIS_PORT=6379
NAUTOBOT_REDIS_PASSWORD=CHANGE_ME
NAUTOBOT_REDIS_SSL=False

# Napalm creds for the switches (used by device "NAPALM" tab / plugins)
NAUTOBOT_NAPALM_USERNAME=admin
NAUTOBOT_NAPALM_PASSWORD=admin

# Device credentials exposed to Nautobot Secrets (environment-variable provider) — used by
# Device Onboarding / Golden Config / Nornir
LAB_DEVICE_USERNAME=admin
LAB_DEVICE_PASSWORD=admin
LAB_DEVICE_SECRET=admin

# Gitea (Golden Config git repositories) — token is generated by install.sh
NMS_IP=10.0.0.10
GITEA_USER=lab
GITEA_PASSWORD=CHANGE_ME
GITEA_TOKEN=
